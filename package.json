{
  "name": "@foxygeo/audit",
  "version": "0.1.1",
  "description": "Lint llms.txt, GPTBot/ClaudeBot access, and schema in CI. Comments AI Readiness on the PR and publishes a public FoxyGEO report.",
  "type": "module",
  "bin": {
    "foxygeo-audit": "bin/foxygeo-audit.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "action.yml",
    "README.md",
    "PUBLISHING.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "audit": "node bin/foxygeo-audit.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "homepage": "https://foxygeo.com/tools/cli-audit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxycorp/audit.git"
  },
  "keywords": [
    "llms.txt",
    "geo",
    "gptbot",
    "claudebot",
    "schema",
    "ci",
    "github-actions",
    "ai-search"
  ],
  "publishConfig": {
    "access": "public"
  }
}
